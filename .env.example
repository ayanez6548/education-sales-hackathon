# Copia este archivo a .env. No guardes secretos reales en el repositorio.
# La demo local no requiere Telegram, Supabase ni un proveedor LLM.

# demo | production
# En production DEMO_MODE debe ser false y los adaptadores no pueden ser demo.
# La ausencia de tokens NUNCA activa adaptadores demo: el proceso falla cerrado.
APP_ENV=demo
DEMO_MODE=true
LOG_LEVEL=INFO
AUTH_ADAPTER=demo

# SQLite (demo sin Docker). Limites: sin SKIP LOCKED real, sin RLS, un escritor a la vez.
DATABASE_URL=sqlite+pysqlite:///./data/education_sales_demo.db

# PostgreSQL (Docker o Supabase). Recomendado para demo de jurado y produccion.
# DATABASE_URL=postgresql+psycopg://education:education@localhost:5432/education_sales

PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

JWT_SECRET=change-me-in-any-non-demo-environment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

DEMO_OPERATOR_EMAIL=operador@demo.local
DEMO_OPERATOR_PASSWORD=demo-operador
DEMO_OPERATOR_NAME=Operador Demo
DEMO_OPERATOR_B_EMAIL=operador-b@demo.local
DEMO_OPERATOR_B_PASSWORD=demo-operador-b
DEMO_OPERATOR_B_NAME=Operadora Beta

# demo | live  (live exige TELEGRAM_BOT_TOKEN y TELEGRAM_WEBHOOK_SECRET reales)
TELEGRAM_ADAPTER=demo
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret

# demo | openai  (openai exige LLM_API_KEY)
LLM_ADAPTER=demo
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=500

MAX_HISTORY_MESSAGES=12
MAX_INPUT_CHARS=4000
MAX_OUTPUT_CHARS=1200

WORKER_ID=worker-local
JOB_LEASE_SECONDS=45
JOB_POLL_SECONDS=0.4
JOB_MAX_ATTEMPTS=5
EMBED_WORKER=true

# AUTH_ADAPTER=supabase exige secret, audiencia e issuer. No hay fallback verify_aud=false.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_SERVICE_ROLE_KEY=

# Variables publicas del frontend: frontend/.env.example
